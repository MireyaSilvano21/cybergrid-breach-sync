{
  "name": "cybergrid-breach-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CyberGrid: Breach & Sync — videojuego web multijugador server-authoritative (Canvas 2D + WebSockets)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^4.22.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
